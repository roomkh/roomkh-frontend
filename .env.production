# Same-origin deploy: nginx proxies /api/v1 to the Spring Boot backend, so a
# relative base URL keeps the bundle portable across domains and avoids CORS.
VITE_API_BASE_URL=/api/v1

# Replace with the real OAuth client id, and add the production origin to that
# client's "Authorized JavaScript origins" in the Google Cloud console.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
